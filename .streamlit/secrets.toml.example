# ---------------------------------------------------------------------------
# PLANTILLA DE SECRETOS - PMML Risk Workspace
#
# Local  : copia este archivo como `.streamlit/secrets.toml` y edita los valores.
# Cloud  : pega el contenido en Manage app -> Settings -> Secrets.
#
# El archivo real `secrets.toml` esta en .gitignore y NO debe subirse a GitHub.
#
# Roles disponibles:
#   admin     - Acceso completo, incluido el diagnostico tecnico del entorno.
#   analista  - Operacion completa sin detalles de infraestructura.
#   consulta  - Solo lectura de analisis y hoja de ruta.
# ---------------------------------------------------------------------------

[usuarios.rt_bistro]
password = "parametrias"
rol      = "admin"
nombre   = "Administrador RT Bistro"

[usuarios.rt_externo]
password = "externos"
rol      = "analista"
nombre   = "Usuario externo"
