# ---------------------------------------------------------------------------
# PLANTILLA DE SECRETOS
#
# Local  : copia este archivo como `.streamlit/secrets.toml` y edita los valores.
# Cloud  : pega el contenido en Manage app -> Settings -> Secrets.
#
# El archivo real `secrets.toml` esta en .gitignore y NO debe subirse a GitHub.
# ---------------------------------------------------------------------------

[credenciales]
# formato:  usuario = "contrasena"
rt_bistro = "cambia_esta_contrasena"
analista_riesgos = "otra_contrasena_segura"
